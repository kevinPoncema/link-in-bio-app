# ----------------- PUERTOS -----------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
MYSQL_PORT=3306

# ----------------- BASE DE DATOS -----------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=link_in_bio_db
DB_USERNAME=link_user
DB_PASSWORD=link_password

# Configuración MySQL Root
MYSQL_ROOT_PASSWORD=root_password

# ----------------- APLICACIÓN -----------------
APP_NAME=LinkInBio
APP_ENV=development
APP_KEY=base64:1ERoxwr3k6f0dj/yvzqEe+lnmU34Jd0sEKJnAGvdhjE=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# ----------------- STORAGE Y ARCHIVOS -----------------
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Configuración para imágenes de perfil
PROFILE_PICTURES_DISK=public
PROFILE_PICTURES_PATH=profile-pictures
MAX_PROFILE_PICTURE_SIZE=2048

# ----------------- SESIÓN Y CACHE -----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ----------------- LOGS -----------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ----------------- MAIL -----------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@linkinbio.app"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------- REDIS -----------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1
